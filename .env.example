# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). Both values are safe to expose to the browser;
# access to data is controlled by row level security policies in Supabase.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
